def sh(*args, timeout=120):
    return subprocess.run([BROWSE, *args], capture_output=True, text=True, timeout=timeout)


def measure(site, settle_seconds):
    nav = sh("navigate", site["url"], timeout=90)
    if nav.returncode != 0:
        return {"name": site["name"], "url": site["url"], "error": (nav.stderr or nav.stdout).strip()[:160]}
    tab = json.loads(nav.stdout)["tab"]
    try:
        # Count only once the page stopped changing: counting before settle measured
        # the skeleton while the snapshot measured the page (booking.com: 0 of 185).
        snapshot = settle(lambda: sh("snapshot", str(tab)).stdout, settle_seconds)
        page = json.loads(sh("eval", str(tab), COUNTS_JS).stdout)
        aria = sh("snapshot", str(tab), "--mode", "aria").stdout
    finally:
        sh("tabs", "close", "--tab", str(tab))

    dom = page["counts"]["controls"]
    snap = len(controls_in(snapshot))
    declared = declared_in(snapshot)
    notes = []
    if dom == 0:
        notes.append("no DOM controls")
        if page["canvas"]:
            notes.append("canvas")
    if is_truncated(snapshot):
        notes.append("truncated")
    if is_dialog_scoped(snapshot):
        notes.append("dialog-scoped")
    if has_iframes(snapshot):
        notes.append("includes iframes")
    if dom and snap == 0:
        notes.append("ZERO")
    return {
        "name": site["name"], "url": page["url"], "why": site.get("why", ""), "title": page["title"],
        "dom": dom, "snap": snap, "aria": len(controls_in(aria)), "declared": declared,
        "coverage": round(snap / dom, 3) if dom else None,
        "accounted": round((snap + declared) / dom, 3) if dom else None,
        "text": page["text"], "canvas": page["canvas"], "virtual": page["virtual"],
        "notes": notes,
    }


def main():
    ap = argparse.ArgumentParser(description="How much of each page a browse snapshot exposes.")
    ap.add_argument("--urls", metavar="JSON", help="[{\"name\", \"url\"}, ...] (default: built-in list)")
    ap.add_argument("--settle", type=float, default=8.0, metavar="SECONDS")
    ap.add_argument("--only", metavar="NAME", help="one site by name")
    ap.add_argument("--json", metavar="PATH", help="also write the rows as JSON")
    ap.add_argument("--list", action="store_true", help="print the sites and exit")
    args = ap.parse_args()

    sites = json.loads(Path(args.urls).read_text())["cases"] if args.urls else DEFAULT_SITES
    if args.only:
        sites = [s for s in sites if s["name"] == args.only]
        if not sites:
            sys.exit(f"no site named {args.only}")
    if args.list:
        for s in sites:
            print(f"{s['name']:<18} {s['url']}")
        return 0

    rows = []
    for site in sites:
        try:
            row = measure(site, args.settle)
        except Exception as exc:  # noqa: BLE001 - one bad site must not stop the survey
            row = {"name": site["name"], "url": site["url"], "error": str(exc)[:160]}
        rows.append(row)
        if "error" in row:
            print(f"{row['name']:<18} ERROR  {row['error']}")
        else:
            cov = "  -  " if row["coverage"] is None else f"{row['coverage']*100:4.0f}%"
            acc = row.get("accounted")
            acc = "  -  " if acc is None else f"{acc*100:4.0f}%"
            note = ",".join(row["notes"])
            print(f"{row['name']:<18} dom {row['dom']:>4}  snap {row['snap']:>4}  aria {row['aria']:>4}  "
                  f"decl {row['declared']:>4}  reach {cov}  all {acc}  {note}")

    measured = [r for r in rows if "error" not in r]
    zero = [r for r in measured if "ZERO" in r["notes"]]
    low = [r for r in measured if r["coverage"] is not None and r["coverage"] < 0.2]
    covs = sorted(r["coverage"] for r in measured if r["coverage"] is not None)
    canvas = [r for r in measured if r["canvas"]]

    print(f"\n{len(measured)} measured, {len(rows) - len(measured)} failed")
    if covs:
        mid = covs[len(covs) // 2]
        print(f"coverage: median {mid*100:.0f}%  under 20%: {len(low)}")
    print(f"exposed nothing while the DOM has controls: {len(zero)}  →  {', '.join(r['name'] for r in zero) or 'none'}")
    print(f"pages with a canvas: {len(canvas)}  →  {', '.join(r['name'] for r in canvas) or 'none'}")

    STATE.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    out = Path(args.json) if args.json else STATE / f"{stamp}.json"
    out.write_text(json.dumps(rows, indent=2, ensure_ascii=False))
    print(f"\nsaved: {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
