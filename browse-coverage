STATE = Path.home() / ".local/state/browse-coverage"

COUNTS_JS = """(() => {
  const q = (s) => document.querySelectorAll(s).length;
  const c = {
    buttons: q("button"),
    role_buttons: q("[role=button]"),
    links: q("a[href]"),
    fields: q("input, select, textarea"),
    editables: q("[contenteditable=true]"),
  };
  c.controls = c.buttons + c.role_buttons + c.links + c.fields + c.editables;
  return { url: location.href, title: document.title, counts: c,
           text: document.body.innerText.length,
           canvas: q("canvas"),
           virtual: q("[aria-setsize], [role=row], [data-index]") };
})()"""

